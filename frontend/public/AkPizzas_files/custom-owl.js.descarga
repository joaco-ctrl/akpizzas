$(document).ready(function() {
	var owl = $('.destacados');
	owl.owlCarousel({
	  margin: 10,
	  smartSpeed: 1500,
	  stagePadding: 0,
	  responsiveClass:true,
	  center: true,
	  nav: false,
	  loop: true,
	  autoplay:true,
	  autoplayTimeout:5000,
	  autoplayHoverPause:true,
	  responsive: {
		0: {
		  items: 2
		},
		600: {
		  items: 3
		},
		1000: {
		  items: 5
		}
	  }
	});

	var owl = $('#owl-services');
	owl.owlCarousel({
